{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grafana Watch Dog",
  "version": "0.1.0",
  "identifier": "io.grafana.watchdog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AI Ops Daily", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 680, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
